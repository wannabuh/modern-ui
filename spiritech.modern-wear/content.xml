<?xml version="1.0" standalone="yes"?>
<!--
  Modern Wear: text tabs (Weapons / Clothing / Implants / Social), the pages, and a
  status line. Slots are the built-in ones (same names and placements, so the game's drop
  targets and tooltips are unchanged), restyled as 42px flat cells: 1px outline (red when
  over-equipped, amber when skill-locked), implant cells tinted blue, social purple, small labels
  when empty. The window is resizable: wider shows more pages side by side (main.lua). Generated from the built-in Wear/content.xml.
-->
