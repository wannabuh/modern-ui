<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Missions: two-line list (default) or icon grid. The window fits the rows, so the
     shared table's scrollbar is never needed; the cover hides it. Bars sit behind the rows. -->
<root>
  <View name="missions" view_layout="stacked">
    <View name="mission_bars" interactive="false" view_layout="stacked" />
    <ScrollView name="mission_grid_scroll" visible="false" capture_input="true" v_scrollbar_mode="auto" scrollbar_width="11" scrollbar_right_inset="1" scrollbar_arrow_gap="1">
      <ScrollViewChild name="mission_grid" view_layout="grid" grid_columns="30" min_columns="1" grid_spacing="2" h_alignment="left" layout_borders="Rect(0,4,0,0)" />
    </ScrollView>
    <View name="mission_list" view_layout="vertical" />
    <View name="mission_cover" interactive="false" fill_color="0xFF0D1015" h_alignment="right" min_size="Point(12,-1)" max_size="Point(12,-1)" />
    <TextView name="mission_empty" interactive="false" visible="false" value="No missions" font_size="11" color="8B95A3" h_alignment="center" v_alignment="center" />
    <TextView name="mission_measure" interactive="false" visible="false" value="" font_size="12" />
  </View>
</root>
