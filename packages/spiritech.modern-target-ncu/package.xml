<?xml version="1.0" encoding="utf-8"?>
<!-- One package for both target NCU windows (nano target and fight target): the game runs
     an instance for each and names it through target_ncu_configure. Turn them on under
     Options → Combat → Targeting (Show nano / fight target's NCU). -->
<Package id="spiritech.modern-target-ncu" name="Modern Target NCU" version="1.2.1" apiVersion="0.2.0">
  <Provides role="prk.target-ncu" />
  <Requires package="spiritech.modern-common" />
  <Script src="main.lua" />
  <InteractionScript src="interaction.lua" />
</Package>
