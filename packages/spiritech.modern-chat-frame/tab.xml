<?xml version="1.0" standalone="yes"?>
<!-- Flat chat tab: label with a 2px teal underline when selected. -->
<root>
  <View name="chat_frame_tab" view_layout="stacked" min_size="Point(-1,17)" max_size="Point(-1,17)" layout_borders="Rect(0,0,10,0)">
    <TextButton name="chat_frame_tab_label" label="" font_size="12" color="8B95A3" hover_color="FFFFFF" pressed_color="4FB3BF" v_alignment="center" />
    <View name="chat_frame_tab_line" interactive="false" visible="false" fill_color="0xFF4FB3BF" min_size="Point(-1,2)" max_size="Point(-1,2)" v_alignment="end" />
  </View>
</root>
