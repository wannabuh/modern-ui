<?xml version="1.0" encoding="utf-8"?>
<!-- One mission offer (40px incl. 2px gap): 32px icon | one or two lines of the server's mission summary.
     Click selects the offer; inspecting (modifier + click) stays native. -->
<root>
  <Button name="offer_row" flat="true" view_layout="stacked" capture_input="true" selection_color="4FB3BF" min_size="Point(-1,40)" max_size="Point(-1,40)" layout_borders="Rect(0,0,0,2)">
    <View name="row_bg" interactive="false" fill_color="0xFF12161C" />
    <View interactive="false" view_layout="horizontal" layout_borders="Rect(4,0,6,0)">
      <ItemSlotView name="row_icon" interactive="false" slot_gfx="" icon_fit="center" v_alignment="start" min_size="Point(32,32)" max_size="Point(32,32)" layout_borders="Rect(0,3,0,0)" />
      <TextView name="row_text" interactive="false" value="" size_to_text="false" font_size="12" color="E8ECF1" weight="1" v_alignment="center" layout_borders="Rect(8,0,0,0)" />
    </View>
  </Button>
</root>
