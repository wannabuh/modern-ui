<?xml version="1.0" encoding="utf-8"?>
<!-- One action row, 21px + 1px gap: 18px icon | name. Left-click uses the action. -->
<root>
  <Button name="action_row" flat="true" view_layout="stacked" capture_input="true" selection_color="4FB3BF" min_size="Point(-1,21)" max_size="Point(-1,21)">
    <View interactive="false" fill_color="0xE60D1015" />
    <View interactive="false" view_layout="horizontal" layout_borders="Rect(3,0,6,0)">
      <ItemSlotView name="row_icon" interactive="false" slot_gfx="" icon_fit="center" v_alignment="center" min_size="Point(18,18)" max_size="Point(18,18)" />
      <TextView name="row_name" interactive="false" value="" font_size="11" color="E8ECF1" v_alignment="center" weight="1" layout_borders="Rect(6,0,0,0)" />
    </View>
  </Button>
</root>
